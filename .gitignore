# Xcode
xcuserdata/
build/
DerivedData/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.build/
.swiftpm/xcode/xcuserdata/

# macOS
*.DS_Store

# Python (CoreML model conversion scripts)
.venv/
__pycache__/
*.pyc

# VS Code
.vscode/

# Claude Code (.claude/)
.claude/skills/swiftui-pro
# Third-party skill installs pulled in for the Windows C# shell work.
.claude/skills/csharp-async
.claude/skills/csharp-xunit
.claude/settings.local.json
.claude/.last-regression-pass
skills-lock.json

# .claude/skills/build/ collides with the global "build/" rule above
!.claude/skills/build/

# Codex (.agents/)
.agents/skills/

# Pin dependency versions in the repo (override the global "Package.resolved" rule).
# The project's copy pins the core (bubio/Bubilator88Core) that the app builds;
# the core's own copy lives in the core repository.
!Package.resolved

# The local-override workspace resolves against ../Bubilator88Core; whatever
# Xcode records for it is per-machine, never the pin.
Bubilator88Dev.xcworkspace/xcshareddata/swiftpm/
Bubilator88Dev.xcworkspace/xcuserdata/

# SwiftUI source folder (not a build dir — override global [Dd]ebug/ rule)
!Bubilator88/Views/Debug/

# Code-coverage artifacts left behind by test runs
*.profraw
*.profdata

# Windows native port — packaging output of scripts/build-windows-package.ps1
# (dotnet publish tree + the distributable zip). Rebuilt on demand; never committed.
dist/

# Stray AI-model conversion output when scripts/convert_realesrgan_onnx.py is
# run from the repo root instead of the models/ directory. The tracked copies
# live under models/ and models/onnx/ (Git LFS).
/RealESRGAN_x2.onnx
/RealESRGAN_x2plus.pth
