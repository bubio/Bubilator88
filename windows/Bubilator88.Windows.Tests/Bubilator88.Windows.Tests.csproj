<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The -windows TFM brings in the Windows SDK WinRT projections (so
         Windows.System.VirtualKey, used by KeyMapping, resolves) without any
         WinUI app machinery. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>

  <!-- The app under test is a self-contained WinUI exe, so a ProjectReference
       would drag the whole WinUI/WindowsAppSDK runtime into the test host (and
       fails its self-contained-architecture check). Instead we source-link only
       the dependency-free, UI-agnostic logic files. They compile into THIS
       assembly, so their `internal` members are reachable without
       InternalsVisibleTo. Add more linked files here as testable logic grows. -->
  <ItemGroup>
    <Compile Include="..\Bubilator88.Windows\RhythmSampleFiles.cs" Link="Linked\RhythmSampleFiles.cs" />
    <Compile Include="..\Bubilator88.Windows\DeploymentFiles.cs" Link="Linked\DeploymentFiles.cs" />
    <None Include="..\..\Bubilator88\Resources\Rhythm_*.wav">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Include="..\Bubilator88.Windows\AutomationHTTPServer.cs" Link="Linked\AutomationHTTPServer.cs" />
    <Compile Include="..\Bubilator88.Windows\AutomationSession.cs" Link="Linked\AutomationSession.cs" />
    <Compile Include="..\Bubilator88.Windows\NativeApi.cs" Link="Linked\NativeApi.cs" />
    <Compile Include="..\Bubilator88.Windows\NativeApi.Automation.cs" Link="Linked\NativeApi.Automation.cs" />
    <Compile Include="..\Bubilator88.Windows\AppAutomationHost.cs" Link="Linked\AppAutomationHost.cs" />
    <Compile Include="..\Bubilator88.Windows\AutomationUiDispatcher.cs" Link="Linked\AutomationUiDispatcher.cs" />
    <Compile Include="..\Bubilator88.Windows\PausedMachineOperation.cs" Link="Linked\PausedMachineOperation.cs" />
    <Compile Include="..\Bubilator88.Windows\AtomicStateFile.cs" Link="Linked\AtomicStateFile.cs" />
    <Compile Include="..\Bubilator88.Windows\AppStateMetadata.cs" Link="Linked\AppStateMetadata.cs" />
    <Compile Include="..\Bubilator88.Windows\WinSaveState.cs" Link="Linked\WinSaveState.cs" />
    <Compile Include="..\Bubilator88.Windows\StateSections.cs" Link="Linked\StateSections.cs" />
    <Compile Include="..\Bubilator88.Windows\EmulatorHost.Media.cs" Link="Linked\EmulatorHost.Media.cs" />
    <Compile Include="..\Bubilator88.Windows\DriveSlot.cs" Link="Linked\DriveSlot.cs" />
    <Compile Include="..\Bubilator88.Windows\KeyMapping.cs" Link="Linked\KeyMapping.cs" />
    <Compile Include="..\Bubilator88.Windows\UpdateFeed.cs" Link="Linked\UpdateFeed.cs" />
    <Compile Include="..\Bubilator88.Windows\PixelMath.cs" Link="Linked\PixelMath.cs" />
    <Compile Include="..\Bubilator88.Windows\Cheats.cs" Link="Linked\Cheats.cs" />
    <Compile Include="..\Bubilator88.Windows\AIModelStore.cs" Link="Linked\AIModelStore.cs" />
    <Compile Include="..\Bubilator88.Windows\FramePublisher.cs" Link="Linked\FramePublisher.cs" />
    <Compile Include="..\Bubilator88.Windows\GameController\ControllerTypes.cs" Link="Linked\ControllerTypes.cs" />
    <Compile Include="..\Bubilator88.Windows\GameController\GameControllerMath.cs" Link="Linked\GameControllerMath.cs" />
    <Compile Include="..\Bubilator88.Windows\Ocr\OcrTypes.cs" Link="Linked\OcrTypes.cs" />
    <Compile Include="..\Bubilator88.Windows\Ocr\ImagePreprocessor.cs" Link="Linked\ImagePreprocessor.cs" />
  </ItemGroup>

</Project>
