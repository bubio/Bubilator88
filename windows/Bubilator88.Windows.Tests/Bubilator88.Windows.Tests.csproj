<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The -windows TFM brings in the Windows SDK WinRT projections (so
         Windows.System.VirtualKey, used by KeyMapping, resolves) without any
         WinUI app machinery. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>

  <!-- The app under test is a self-contained WinUI exe, so a ProjectReference
       would drag the whole WinUI/WindowsAppSDK runtime into the test host (and
       fails its self-contained-architecture check). Instead we source-link only
       the dependency-free, UI-agnostic logic files. They compile into THIS
       assembly, so their `internal` members are reachable without
       InternalsVisibleTo. Add more linked files here as testable logic grows. -->
  <ItemGroup>
    <Compile Include="..\Bubilator88.Windows\KeyMapping.cs" Link="Linked\KeyMapping.cs" />
    <Compile Include="..\Bubilator88.Windows\PixelMath.cs" Link="Linked\PixelMath.cs" />
    <Compile Include="..\Bubilator88.Windows\GameController\ControllerTypes.cs" Link="Linked\ControllerTypes.cs" />
    <Compile Include="..\Bubilator88.Windows\GameController\GameControllerMath.cs" Link="Linked\GameControllerMath.cs" />
  </ItemGroup>

</Project>
