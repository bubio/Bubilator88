<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bubilator88.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="Root" IsTabStop="True" Background="Black" RequestedTheme="Dark"
          KeyDown="OnKeyDown" KeyUp="OnKeyUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main menu -->
        <muxc:MenuBar Grid.Row="0"
                      Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <muxc:MenuBarItem Title="Emulator">
                <MenuFlyoutItem x:Name="PauseResumeItem" Text="Pause" Click="OnPauseResume">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="R" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Reset" Click="OnReset">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="E" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Boot Mode">
                    <muxc:RadioMenuFlyoutItem x:Name="BootN88V2" Text="N88-BASIC V2" GroupName="Boot"
                                              IsChecked="True" Click="OnBootMode" Tag="0" />
                    <muxc:RadioMenuFlyoutItem x:Name="BootN88V1H" Text="N88-BASIC V1H" GroupName="Boot"
                                              Click="OnBootMode" Tag="1" />
                    <muxc:RadioMenuFlyoutItem x:Name="BootN88V1S" Text="N88-BASIC V1S" GroupName="Boot"
                                              Click="OnBootMode" Tag="2" />
                    <muxc:RadioMenuFlyoutItem x:Name="BootNBasic" Text="N-BASIC" GroupName="Boot"
                                              Click="OnBootMode" Tag="3" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="CPU Clock">
                    <muxc:RadioMenuFlyoutItem x:Name="Clock8" Text="8 MHz" GroupName="Clock"
                                              IsChecked="True" Click="OnClock" Tag="8" />
                    <muxc:RadioMenuFlyoutItem x:Name="Clock4" Text="4 MHz" GroupName="Clock"
                                              Click="OnClock" Tag="4" />
                </MenuFlyoutSubItem>
            </muxc:MenuBarItem>

            <muxc:MenuBarItem Title="Disk">
                <!-- Submenu children (Mount/Eject/Write Protect + per-image radio
                     list) are built in code (RebuildDiskMenu), mirroring the
                     macOS Disk menu. The top-level structure is static here. -->
                <MenuFlyoutSubItem x:Name="Drive0Sub" Text="Drive 1" />
                <MenuFlyoutSubItem x:Name="Drive1Sub" Text="Drive 2" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="BothSub" Text="Drive 1&amp;2" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="RecentSub" Text="Recent Files" />
            </muxc:MenuBarItem>

            <muxc:MenuBarItem Title="View">
                <muxc:RadioMenuFlyoutItem x:Name="Scale1" Text="Actual Size (×1)" GroupName="Scale" Click="OnWindowScale" Tag="1" />
                <muxc:RadioMenuFlyoutItem x:Name="Scale2" Text="Double Size (×2)" GroupName="Scale"
                                          IsChecked="True" Click="OnWindowScale" Tag="2" />
                <muxc:RadioMenuFlyoutItem x:Name="Scale4" Text="Quad Size (×4)" GroupName="Scale" Click="OnWindowScale" Tag="4" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="FullscreenItem" Text="Fullscreen" Click="OnToggleFullscreen">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="None" Key="F11" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
            </muxc:MenuBarItem>

            <muxc:MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About Bubilator88" Click="OnAbout" />
            </muxc:MenuBarItem>
        </muxc:MenuBar>

        <SwapChainPanel x:Name="ScreenPanel" Grid.Row="1" SizeChanged="OnPanelSizeChanged" />

        <!-- Status bar. Layout mirrors macOS left→right: boot mode, clock,
             Drive 2, Drive 1 on the left; volume, fps, run-state LED on the
             right (real-hardware drive order = Drive 2 before Drive 1). -->
        <Grid Grid.Row="2" Padding="8,3" ColumnSpacing="12"
              Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="ModeLabel" FontSize="12" VerticalAlignment="Center" Text="N88-V2" />
                <TextBlock x:Name="ClockLabel" FontSize="12" VerticalAlignment="Center" Text="8MHz" />

                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Ellipse x:Name="Drive1Led" Width="9" Height="9" Fill="#33FFFFFF" />
                    <TextBlock x:Name="Drive1Label" FontSize="12" VerticalAlignment="Center" Opacity="0.85"
                               TextTrimming="CharacterEllipsis" Text="D2: Empty" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Ellipse x:Name="Drive0Led" Width="9" Height="9" Fill="#33FFFFFF" />
                    <TextBlock x:Name="Drive0Label" FontSize="12" VerticalAlignment="Center" Opacity="0.85"
                               TextTrimming="CharacterEllipsis" Text="D1: Empty" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE767;" FontSize="12" VerticalAlignment="Center" Opacity="0.8" />
                    <Slider x:Name="VolumeSlider" Width="84" Minimum="0" Maximum="100"
                            VerticalAlignment="Center" StepFrequency="10"
                            IsThumbToolTipEnabled="True" ValueChanged="OnVolumeChanged" />
                </StackPanel>
                <TextBlock x:Name="FpsLabel" FontSize="12" VerticalAlignment="Center"
                           MinWidth="52" Text="-- fps" />
                <Ellipse x:Name="RunStateLed" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="LimeGreen" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
