<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bubilator88.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="Root" IsTabStop="True" Background="Black" RequestedTheme="Dark"
          KeyDown="OnKeyDown" KeyUp="OnKeyUp">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main menu -->
        <muxc:MenuBar Grid.Row="0"
                      Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <muxc:MenuBarItem Title="Emulator">
                <MenuFlyoutItem Text="Settings…" Click="OnSettings" />
                <MenuFlyoutSeparator />
                <!-- Shortcuts are dispatched in code (OnKeyDown) because the screen
                     greedily consumes letter/number keys for the PC-8801 matrix,
                     which pre-empts XAML KeyboardAccelerators. These overrides only
                     render the hint text next to the item. -->
                <MenuFlyoutItem x:Name="PauseResumeItem" Text="Pause" Click="OnPauseResume"
                                KeyboardAcceleratorTextOverride="Ctrl+R" />
                <MenuFlyoutItem Text="Reset" Click="OnReset"
                                KeyboardAcceleratorTextOverride="Ctrl+E" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Boot Mode">
                    <muxc:RadioMenuFlyoutItem x:Name="BootN88V2" Text="N88-BASIC V2" GroupName="Boot"
                                              IsChecked="True" Click="OnBootMode" Tag="0" />
                    <muxc:RadioMenuFlyoutItem x:Name="BootN88V1H" Text="N88-BASIC V1H" GroupName="Boot"
                                              Click="OnBootMode" Tag="1" />
                    <muxc:RadioMenuFlyoutItem x:Name="BootN88V1S" Text="N88-BASIC V1S" GroupName="Boot"
                                              Click="OnBootMode" Tag="2" />
                    <muxc:RadioMenuFlyoutItem x:Name="BootNBasic" Text="N-BASIC" GroupName="Boot"
                                              Click="OnBootMode" Tag="3" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="CPU Clock">
                    <muxc:RadioMenuFlyoutItem x:Name="Clock8" Text="8 MHz" GroupName="Clock"
                                              IsChecked="True" Click="OnClock" Tag="8" />
                    <muxc:RadioMenuFlyoutItem x:Name="Clock4" Text="4 MHz" GroupName="Clock"
                                              Click="OnClock" Tag="4" />
                </MenuFlyoutSubItem>
            </muxc:MenuBarItem>

            <muxc:MenuBarItem Title="Disk">
                <!-- Submenu children (Mount/Eject/Write Protect + per-image radio
                     list) are built in code (RebuildDiskMenu), mirroring the
                     macOS Disk menu. The top-level structure is static here. -->
                <MenuFlyoutSubItem x:Name="Drive0Sub" Text="Drive 1" />
                <MenuFlyoutSubItem x:Name="Drive1Sub" Text="Drive 2" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="BothSub" Text="Drive 1&amp;2" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="RecentSub" Text="Recent Files" />
            </muxc:MenuBarItem>

            <muxc:MenuBarItem Title="View">
                <muxc:RadioMenuFlyoutItem x:Name="Scale1" Text="Actual Size (×1)" GroupName="Scale" Click="OnWindowScale" Tag="1" />
                <muxc:RadioMenuFlyoutItem x:Name="Scale2" Text="Double Size (×2)" GroupName="Scale"
                                          IsChecked="True" Click="OnWindowScale" Tag="2" />
                <muxc:RadioMenuFlyoutItem x:Name="Scale4" Text="Quad Size (×4)" GroupName="Scale" Click="OnWindowScale" Tag="4" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="FullscreenItem" Text="Fullscreen" Click="OnToggleFullscreen"
                                      KeyboardAcceleratorTextOverride="F11" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Video Filter">
                    <muxc:RadioMenuFlyoutItem x:Name="FilterNone" Text="None" GroupName="Filter"
                                              IsChecked="True" Click="OnVideoFilter" Tag="None" />
                    <muxc:RadioMenuFlyoutItem x:Name="FilterLinear" Text="Linear" GroupName="Filter"
                                              Click="OnVideoFilter" Tag="Linear" />
                    <muxc:RadioMenuFlyoutItem x:Name="FilterBicubic" Text="Bicubic" GroupName="Filter"
                                              Click="OnVideoFilter" Tag="Bicubic" />
                    <muxc:RadioMenuFlyoutItem x:Name="FilterCRT" Text="CRT" GroupName="Filter"
                                              Click="OnVideoFilter" Tag="CRT" />
                    <muxc:RadioMenuFlyoutItem x:Name="FilterXBRZ" Text="xBRZ" GroupName="Filter"
                                              Click="OnVideoFilter" Tag="xBRZ" />
                    <muxc:RadioMenuFlyoutItem x:Name="FilterEnhanced" Text="Enhanced" GroupName="Filter"
                                              Click="OnVideoFilter" Tag="Enhanced" />
                    <muxc:RadioMenuFlyoutItem x:Name="FilterAIFast" Text="AI Upscale (Fast)" GroupName="Filter"
                                              Click="OnVideoFilter" Tag="AIFast" />
                    <muxc:RadioMenuFlyoutItem x:Name="FilterAIBalanced" Text="AI Upscale (Balanced)" GroupName="Filter"
                                              Click="OnVideoFilter" Tag="AIBalanced" />
                    <muxc:RadioMenuFlyoutItem x:Name="FilterAIQuality" Text="AI Upscale (Quality)" GroupName="Filter"
                                              Click="OnVideoFilter" Tag="AIQuality" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="ScanlineItem" Text="Scanlines" Click="OnScanlines" />
            </muxc:MenuBarItem>

            <muxc:MenuBarItem Title="Control">
                <MenuFlyoutSubItem Text="CPU Speed">
                    <muxc:RadioMenuFlyoutItem x:Name="Speed1" Text="x1" GroupName="Speed"
                                              IsChecked="True" Click="OnCpuSpeed" Tag="1" />
                    <muxc:RadioMenuFlyoutItem x:Name="Speed2" Text="x2" GroupName="Speed" Click="OnCpuSpeed" Tag="2" />
                    <muxc:RadioMenuFlyoutItem x:Name="Speed4" Text="x4" GroupName="Speed" Click="OnCpuSpeed" Tag="4" />
                    <muxc:RadioMenuFlyoutItem x:Name="Speed8" Text="x8" GroupName="Speed" Click="OnCpuSpeed" Tag="8" />
                    <muxc:RadioMenuFlyoutItem x:Name="Speed16" Text="x16" GroupName="Speed" Click="OnCpuSpeed" Tag="16" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Save Screenshot…" Click="OnSaveScreenshot" />
                <MenuFlyoutItem Text="Copy Screen" Click="OnCopyScreen"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+C" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Quick Save" Click="OnQuickSave"
                                KeyboardAcceleratorTextOverride="Ctrl+S" />
                <MenuFlyoutItem Text="Quick Load" Click="OnQuickLoad"
                                KeyboardAcceleratorTextOverride="Ctrl+L" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Save State…" Click="OnSaveStateSheet" />
                <MenuFlyoutItem Text="Load State…" Click="OnLoadStateSheet" />
            </muxc:MenuBarItem>

            <muxc:MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About Bubilator88" Click="OnAbout" />
            </muxc:MenuBarItem>
        </muxc:MenuBar>

        <SwapChainPanel x:Name="ScreenPanel" Grid.Row="1" SizeChanged="OnPanelSizeChanged" />

        <!-- OCR text-detection overlay. Masked: no menu item or shortcut key
             activates it (see windows/README.md) — recognition accuracy on
             PC-88 text proved too poor to be usable. Left in place, empty,
             so the wiring survives for a future revisit. -->
        <Canvas x:Name="OcrOverlayCanvas" Grid.Row="1" IsHitTestVisible="False" Background="Transparent" />

        <!-- Status bar. Layout mirrors macOS left→right: boot mode, clock,
             Drive 2, Drive 1 on the left; volume, fps, run-state LED on the
             right (real-hardware drive order = Drive 2 before Drive 1). -->
        <Grid Grid.Row="2" Padding="8,3" ColumnSpacing="12"
              Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="ModeLabel" FontSize="12" VerticalAlignment="Center" Text="N88-V2" />
                <TextBlock x:Name="ClockLabel" FontSize="12" VerticalAlignment="Center" Text="8MHz" />

