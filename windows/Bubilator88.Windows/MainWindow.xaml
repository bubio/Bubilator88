0215 21.0048C20.4448 20.7891 20.789 20.4449 21.0048 20.0215C21.1054 19.824 21.1745 19.5633 21.2116 19.1094C21.2494 18.6467 21.25 18.0525 21.25 17.2001V8.32554C21.25 7.80066 21.2452 7.66046 21.2155 7.53668C21.1848 7.40913 21.1343 7.2872 21.0658 7.17536C20.9993 7.06682 20.9036 6.96427 20.5324 6.59313L17.4069 3.46764C17.0358 3.0965 16.9332 3.00077 16.8247 2.93425C16.7129 2.86572 16.5909 2.81521 16.4634 2.78459ZM8 14.25C7.58579 14.25 7.25 14.5858 7.25 15V21.25H16.75V15C16.75 14.5858 16.4142 14.25 16 14.25H8Z"
                          Stretch="Uniform" Width="16" Height="16"
                          Fill="{ThemeResource TextFillColorPrimaryBrush}"
                          VerticalAlignment="Center" Opacity="0.8" />
                    <TextBlock x:Name="Drive1Label" FontSize="12" VerticalAlignment="Center" Opacity="0.85"
                               TextTrimming="CharacterEllipsis" Text="2: Empty" />
                    <FontIcon x:Name="Drive1LockIcon" Glyph="&#xE72E;" FontSize="11"
                              VerticalAlignment="Center" Opacity="0.8" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Ellipse x:Name="Drive0Led" Width="9" Height="9" Fill="#33FFFFFF" />
                    <Path Data="F0 M14.5 6.75C14.9142 6.75 15.25 7.08579 15.25 7.5C15.25 7.91421 14.9142 8.25 14.5 8.25L9.5 8.25C9.08579 8.25 8.75 7.91421 8.75 7.5C8.75 7.08579 9.08579 6.75 9.5 6.75L14.5 6.75Z M4.76853 22.7067C5.23901 22.7451 5.80742 22.7495 6.4964 22.75L6.5 22.75H17.5L17.5036 22.75C18.1926 22.7495 18.761 22.7451 19.2315 22.7067C19.7781 22.662 20.2582 22.5677 20.7025 22.3413C21.4081 21.9818 21.9817 21.4081 22.3413 20.7025C22.5676 20.2583 22.662 19.7782 22.7066 19.2315C22.75 18.7006 22.75 18.045 22.75 17.2322L22.75 8.25307C22.7503 7.83445 22.7505 7.50492 22.674 7.18651C22.6067 6.90591 22.4955 6.63766 22.3448 6.39161C22.1737 6.1124 21.9405 5.87953 21.6443 5.5837L18.4163 2.35571C18.1205 2.05953 17.8876 1.82639 17.6084 1.65529C17.3624 1.50452 17.0941 1.3934 16.8135 1.32604C16.4951 1.24959 16.1656 1.24978 15.747 1.25003L6.7679 1.25005C5.95506 1.25005 5.29944 1.25004 4.76853 1.29342C4.2219 1.33808 3.74175 1.43244 3.29754 1.65878C2.59193 2.01831 2.01825 2.59198 1.65873 3.29759C1.43239 3.74181 1.33803 4.22195 1.29336 4.76859C1.24999 5.29949 1.24999 5.9551 1.25 6.76794V17.2322C1.24999 18.045 1.24999 18.7006 1.29336 19.2315C1.33803 19.7782 1.43239 20.2583 1.65873 20.7025C2.01825 21.4081 2.59193 21.9818 3.29754 22.3413C3.74175 22.5677 4.2219 22.662 4.76853 22.7067ZM16.4634 2.78459C16.3396 2.75487 16.1994 2.75005 15.6745 2.75005H6.8C5.94755 2.75005 5.35331 2.75064 4.89068 2.78844C4.43681 2.82552 4.17604 2.89465 3.97852 2.99529C3.55516 3.21101 3.21095 3.55521 2.99524 3.97858C2.8946 4.17609 2.82547 4.43686 2.78838 4.89073C2.75058 5.35337 2.75 5.9476 2.75 6.80006V17.2001C2.75 18.0525 2.75058 18.6467 2.78838 19.1094C2.82547 19.5633 2.8946 19.824 2.99524 20.0215C3.21095 20.4449 3.55516 20.7891 3.97852 21.0048C4.17604 21.1055 4.43681 21.1746 4.89068 21.2117C5.13442 21.2316 5.41469 21.2412 5.75 21.2458V15C5.75 13.7574 6.75736 12.75 8 12.75H16C17.2426 12.75 18.25 13.7574 18.25 15V21.2458C18.5853 21.2412 18.8656 21.2316 19.1093 21.2117C19.5632 21.1746 19.824 21.1055 20.0215 21.0048C20.4448 20.7891 20.789 20.4449 21.0048 20.0215C21.1054 19.824 21.1745 19.5633 21.2116 19.1094C21.2494 18.6467 21.25 18.0525 21.25 17.2001V8.32554C21.25 7.80066 21.2452 7.66046 21.2155 7.53668C21.1848 7.40913 21.1343 7.2872 21.0658 7.17536C20.9993 7.06682 20.9036 6.96427 20.5324 6.59313L17.4069 3.46764C17.0358 3.0965 16.9332 3.00077 16.8247 2.93425C16.7129 2.86572 16.5909 2.81521 16.4634 2.78459ZM8 14.25C7.58579 14.25 7.25 14.5858 7.25 15V21.25H16.75V15C16.75 14.5858 16.4142 14.25 16 14.25H8Z"
                          Stretch="Uniform" Width="16" Height="16"
                          Fill="{ThemeResource TextFillColorPrimaryBrush}"
                          VerticalAlignment="Center" Opacity="0.8" />
                    <TextBlock x:Name="Drive0Label" FontSize="12" VerticalAlignment="Center" Opacity="0.85"
                               TextTrimming="CharacterEllipsis" Text="1: Empty" />
                    <FontIcon x:Name="Drive0LockIcon" Glyph="&#xE72E;" FontSize="11"
                              VerticalAlignment="Center" Opacity="0.8" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE767;" FontSize="12" VerticalAlignment="Center" Opacity="0.8" />
                    <!-- IsTabStop=False so Tab never parks focus here; a pointer
                         press still focuses it, but PointerCaptureLost returns
                         focus to the emulation view when the drag/click ends. -->
                    <Slider x:Name="VolumeSlider" Width="84" Minimum="0" Maximum="100"
                            IsTabStop="False"
                            VerticalAlignment="Center" StepFrequency="10"
                            IsThumbToolTipEnabled="True" ValueChanged="OnVolumeChanged" />
                </StackPanel>
                <TextBlock x:Name="FpsLabel" FontSize="12" VerticalAlignment="Center"
                           MinWidth="52" Text="-- fps" />
                <Ellipse x:Name="RunStateLed" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="LimeGreen" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
