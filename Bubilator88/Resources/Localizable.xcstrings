          "stringUnit": {
            "state": "translated",
            "value": "Bubilator88 について"
          }
        }
      }
    },
    "Active Controller": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなコントローラ"
