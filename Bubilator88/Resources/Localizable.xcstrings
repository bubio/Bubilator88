{
  "sourceLanguage": "en",
  "strings": {
    "\"%1$@\" has no entry %2$ld (it contains %3$ld entries).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" にエントリ %2$ld は存在しません (全 %3$ld 件)。"
          }
        }
      }
    },
    "\"%1$@\" has no image %2$ld (it contains %3$ld image(s)).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" にイメージ %2$ld は存在しません (全 %3$ld 面)。"
          }
        }
      }
    },
    "\"%@\" contains no disk image entries.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" にディスクイメージのエントリがありません。"
          }
        }
      }
    },
    "\"%@\" could not be read. The file may be missing, unreadable, or on a disconnected volume.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を読み込めませんでした。ファイルが存在しないか、アクセスできないか、接続されていないボリュームにある可能性があります。"
          }
        }
      }
    },
    "\"%@\" is a PC-8801 tape image (T88), not a D88 disk image. Bubilator88 does not support T88 files.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は PC-8801 テープイメージ (T88) であり、D88 ディスクイメージではありません。Bubilator88 は T88 ファイルに対応していません。"
          }
        }
      }
    },
    "\"%@\" is a relative path. URLs must use absolute paths.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" は相対パスです。URL には絶対パスを指定してください。"
          }
        }
      }
    },
    "\"%@\" is an archive, but it does not contain any D88 disk images.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はアーカイブですが、D88 ディスクイメージが含まれていません。"
          }
        }
      }
    },
    "\"%@\" is not a valid D88 disk image.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" は有効な D88 ディスクイメージではありません。"
          }
        }
      }
    },
    "\"%@\" is not a valid D88 disk image. The header is missing or the file is corrupted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は有効な D88 ディスクイメージではありません。ヘッダが欠落しているかファイルが破損しています。"
          }
        }
      }
    },
    "%1$@ line %2$ld: %3$@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$ld 行目: %3$@"
          }
        }
      }
    },
    "%@ <byte>": {
      "comment": "EmulatorCore script error, looked up at runtime by ScriptErrorLocalization",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ <byte>"
          }
        }
      }
    },
    "(unnamed)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(名称なし)"
          }
        }
      }
    },
    "4 MHz": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4 MHz"
          }
        }
      }
    },
    "8 MHz": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8 MHz"
          }
        }
      }
    },
    "<drive> <path> [image <index>]": {
      "comment": "EmulatorCore script error, looked up at runtime by ScriptErrorLocalization",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<drive> <path> [image <index>]"
          }
        }
      }
    },
