        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(名称なし)"
          }
        }
      }
    },
    "16 bytes from this address, read through the main Z80 bus": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスから 16 バイト。メイン Z80 のバス経由で読み出す"
          }
        }
      }
    },
    "16-bit address to display, in hex. Accepts 1234, 0x1234 and 1234H.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示する 16 ビットアドレス (16 進)。1234 / 0x1234 / 1234H のいずれの書式でも可。"
          }
        }
      }
    },
    "1× (Real)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1×(実機)"
          }
        }
      }
    },
