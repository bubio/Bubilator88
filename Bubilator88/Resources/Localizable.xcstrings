    "Actual Size (x1)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "等倍 (x1)"
          }
        }
      }
    },
    "An m3u/m3u8 playlist must be the only image file (it cannot be combined with .d88 files or with another playlist).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "m3u/m3u8 プレイリストは単独で指定してください (d88 との混在や複数指定はできません)。"
          }
        }
      }
    },
    "Apple ProRes 4444 (.mov)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ProRes 4444 (.mov)"
          }
        }
      }
    },
    "Applied on next reset.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回リセット時に反映されます。"
          }
        }
      }
    },
    "Applies a chorus effect to mono FM output for stereo widening.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モノラルFM出力にコーラスエフェクトを適用してステレオ感を拡張します。"
          }
        }
      }
    },
