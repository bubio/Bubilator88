{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    " " : {

    },
    "  %@ ✓" : {

    },
    "\"%@\" contains no disk image entries." : {
      "comment" : "Error: an m3u/m3u8 playlist has only blank or comment lines. %@ is the playlist path",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" にディスクイメージのエントリがありません。"
          }
        }
      }
    },
    "\"%@\" could not be read. The file may be missing, unreadable, or on a disconnected volume." : {
      "comment" : "Disk load failure: file unreadable",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を読み込めませんでした。ファイルが存在しないか、アクセスできないか、接続されていないボリュームにある可能性があります。"
          }
        }
      }
    },
    "\"%@\" is a PC-8801 tape image (T88), not a D88 disk image. Bubilator88 does not support T88 files." : {
      "comment" : "Disk load failure: file is a T88 tape image",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は PC-8801 テープイメージ (T88) であり、D88 ディスクイメージではありません。Bubilator88 は T88 ファイルに対応していません。"
          }
        }
      }
    },
    "\"%@\" is a relative path. URLs must use absolute paths." : {
      "comment" : "Launch URL error: URLs have no working directory to resolve against. %@ is the path as written",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" は相対パスです。URL には絶対パスを指定してください。"
          }
        }
      }
    },
    "\"%@\" is an archive, but it does not contain any D88 disk images." : {
      "comment" : "Disk load failure: archive contains no D88",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はアーカイブですが、D88 ディスクイメージが含まれていません。"
          }
        }
      }
    },
    "\"%@\" is not a valid D88 disk image." : {
      "comment" : "Error: a file named in the launch arguments is readable but is not a D88 image. %@ is the file path",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" は有効な D88 ディスクイメージではありません。"
          }
        }
      }
    },
    "\"%@\" is not a valid D88 disk image. The header is missing or the file is corrupted." : {
      "comment" : "Disk load failure: file is not a D88",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は有効な D88 ディスクイメージではありません。ヘッダが欠落しているかファイルが破損しています。"
          }
        }
      }
    },
    "\"%1$@\" has no entry %2$ld (it contains %3$ld entries)." : {
      "comment" : "Error: the entry number given in the launch arguments is past the end of the playlist. %1 playlist path, %2 requested 1-based entry number, %3 number of entries",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" にエントリ %2$ld は存在しません (全 %3$ld 件)。"
          }
        }
      }
    },
    "\"%1$@\" has no image %2$ld (it contains %3$ld image(s))." : {
      "comment" : "Error: the image number given in the launch arguments is past the end of the D88 file. %1 file path, %2 requested 1-based image number, %3 number of images in the file",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" にイメージ %2$ld は存在しません (全 %3$ld 面)。"
          }
        }
      }
    },
    "(%@=%@ %@=%@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "(%1$@=%2$@ %3$@=%4$@)"
